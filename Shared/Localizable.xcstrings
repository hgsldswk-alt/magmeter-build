    "share.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same phone, same angle. How much does the reading change near your magnet?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一台手机，同一姿势，试试离磁铁近一点时的读数。"
