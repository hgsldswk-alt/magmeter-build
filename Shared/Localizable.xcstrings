    "baseline.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t set a baseline. Hold the phone still and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能设置基线。请拿稳手机后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定基準。請拿穩手機後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準を設定できませんでした。スマホを静止させてもう一度お試しください。"
          }
        }
      }
    },
    "baseline.hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Hold still away from the target for one second."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。远离目标，保持静止一秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。遠離目標，保持靜止一秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。対象から離れた場所で1秒間静止してください。"
          }
        }
      }
    },
