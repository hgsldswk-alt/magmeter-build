    "settings.hapticsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short vibration after a scan peak. The text shows when to sweep back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描峰值结束后轻震一下，回扫时机以文字提示为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描峰值結束後輕震一下，回掃時機以文字提示為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンのピーク後に短く振動します。戻るタイミングは文字で表示されます。"
          }
        }
      }
    },
    "settings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements stay on this iPhone. No account, ads or subscription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
