    "scan.markedDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your marked reading is in Saved comparisons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记的读数可在「已保存的对照」中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已標記的讀數可在「已儲存的比較」中查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印を付けた測定値は「保存した比較」にあります。"
          }
        }
      }
    },
    "scan.metalLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steel and magnets can change the reading. Aluminum and copper usually won’t register."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钢铁与磁铁可能改变读数。铝和铜通常没有明显响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋼鐵和磁鐵可能改變讀數。鋁和銅通常沒有明顯反應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉄や磁石で値が変わります。アルミや銅はふつう反応しません。"
          }
        }
      }
    },
    "scan.metalSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove magnetic cases and mounts. Try a small magnet or a steel paper clip first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取下磁吸壳和支架，可先拿小磁铁或钢质回形针试测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取下磁吸殼和支架，可先拿小磁鐵或鋼質迴紋針試測。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁石付きのケースやホルダーを外してください。まず小さな磁石か鉄のクリップで試しましょう。"
          }
        }
      }
    },
    "scan.metalSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for a change in the field"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察磁场变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察磁場變化"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁場の変化を探す"
          }
        }
      }
    },
    "scan.metalSweep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the same angle as you bring the phone closer. End the scan if you see no clear change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持同一姿势慢慢靠近。没有明显变化时，可以结束扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持同一姿勢慢慢靠近。沒有明顯變化時，可以結束掃描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ角度のままスマホを近づけてください。はっきりした変化がなければスキャンを終了します。"
          }
        }
      }
    },
    "scan.metalTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan close to the object"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近物件扫描"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近物件掃描"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象の近くでスキャン"
          }
        }
      }
    },
    "scan.resweep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep back to check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿原路线回扫确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿原路線回掃確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻って確認"
          }
        }
      }
    },
    "scan.resweepDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A peak appeared. Sweep back slowly along the same path. Look for a similar change at the same spot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现一次峰值。请沿原路线慢慢回扫，观察同一位置是否出现类似变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現一次峰值。請沿原路線慢慢回掃，觀察同一位置是否出現類似變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピークが出ました。同じ経路をゆっくり戻って、同じ場所で似た変化があるか確かめてください。"
          }
        }
      }
    },
    "scan.similar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A similar change appeared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现类似变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現類似變化"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似た変化がありました"
          }
        }
      }
    },
    "scan.similarDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it was in the same place, return to that spot, hold steady and mark it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出现在同一位置，请回到那里，拿稳手机后手工标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果出現在同一位置，請回到那裡，拿穩手機後手動標記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ場所なら、その地点に戻って静止し、印を付けてください。"
          }
        }
      }
    },
    "scan.slow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue sweeping slowly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续慢扫"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續慢掃"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり動かし続ける"
          }
        }
      }
    },
    "scan.wallLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the change as a clue to a shallow steel nail or screw. Check the wall with a suitable tool before drilling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读数只提供浅层钢钉或螺丝的线索。钻孔前请用合适的工具检查墙体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀數只提供淺層鋼釘或螺絲的線索。鑽孔前請用合適的工具檢查牆面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変化は浅い位置の鉄の釘やねじの手がかりです。穴あけの前に適した道具で壁を確認してください。"
          }
        }
      }
    },
    "scan.wallSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove magnetic accessories. Start beside the area and keep the phone at a consistent distance from the wall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取下磁吸配件，从目标区域旁边开始，让手机与墙保持相近的距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取下磁吸配件，從目標區域旁邊開始，讓手機與牆面保持相近的距離。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁石付きアクセサリーを外してください。範囲の横から始め、壁との距離を一定に保ちます。"
          }
        }
      }
    },
    "scan.wallSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for shallow steel fasteners"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寻找浅层钢钉或螺丝的线索"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找淺層鋼釘或螺絲的線索"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浅い位置の鉄の留め具を探す"
          }
        }
      }
    },
    "scan.wallSweep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep sideways, keeping the same angle and distance. End the scan if you see no clear change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持姿势和距离，沿墙横向慢扫。没有明显变化时，可以结束扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持姿勢和距離，沿牆橫向慢掃。沒有明顯變化時，可以結束掃描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ角度と距離のまま横に動かしてください。はっきりした変化がなければスキャンを終了します。"
          }
        }
      }
    },
    "scan.wallTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on a flat area of the wall"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从平整墙面开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從平整牆面開始"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁の平らな部分から始める"
          }
        }
      }
    },
    "sensor.saturated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the phone farther from the magnet to resume readings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将手机移远一些，等待读数恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將手機移遠一些，等候讀數恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁石からスマホを離すと測定が再開します。"
          }
        }
      }
    },
    "sensor.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
