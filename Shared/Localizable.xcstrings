    "share.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a spot away from a magnet, hold the phone steady and set the baseline. Then move closer at the same angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在远离磁铁的位置拿稳手机并设基线，再保持姿势慢慢靠近。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在遠離磁鐵的位置拿穩手機並設基準，再保持姿勢慢慢靠近。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "磁石から離れた場所でスマホを静止させ、基準を設定します。そのあと同じ角度で近づけてください。"
          }
        }
