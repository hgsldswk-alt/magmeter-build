    "scan.marked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot marked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记点位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已標記測點"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
